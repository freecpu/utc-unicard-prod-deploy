# =============================================================================
# agent-mp 生产 .env 模板 v1.0（2026-11-19，S0 制备；REQ-20261113-01 G5）
# 落机位置＝第四台机 /data/apps/agent-mp/.env（权限 600；本模板已按用户指示落机）
# 本件为占位模板（无真值）可入 git；机上 .env 填入真值后【严禁】拉回 git/Hub/文书。
# 键面＝S5 仓 .env.sample 58 键全映射；生产口径依方案 v1.1（D1 修订/D2/D3）。
# -----------------------------------------------------------------------------
# 填值分工（三类标记）：
#   [用户填]＝用户经 SSH 自行编辑机上 .env 填入（值不经 S0/git）
#   [S0填] ＝S0 在 G5-prep/G5 取证或 DBA 交回后受控注入
#   [暂缓] ＝凭据未就位/运行期零消费，占位维持不阻塞启动（yml/源码实读定案）
# 格式：KEY=VALUE 纯 dotenv；含 # 的值用双引号；&/{}/%2B 为字面无需引号。
# 占位符约定：敏感键值 MASKED＝待填占位（门禁 REDACTED 形态，非真值）；
#             __DBA_*__＝待 DBA 交回后由 S0 替换；空值＝fail-closed 待取证。
# =============================================================================

# --- 类1：本实例数据库（D2 外置 DBA 库；UNICARD/KUAIFU 同指·D26 Option A）---
# [S0填] DBA 交回库名/地址:端口/账号后注入；口令走受控通道（DBA→用户→S0 或用户自填）
AGENTMP_UNICARD_URL=jdbc:mysql://__DBA_HOST__:__DBA_PORT__/__DBA_DBNAME__?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2B8
AGENTMP_UNICARD_USER=__DBA_APP_USER__
AGENTMP_UNICARD_PWD=MASKED
AGENTMP_KUAIFU_URL=jdbc:mysql://__DBA_HOST__:__DBA_PORT__/__DBA_DBNAME__?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2B8
AGENTMP_KUAIFU_USER=__DBA_APP_USER__
AGENTMP_KUAIFU_PWD=MASKED

# --- 类2：UTC 通道（D3 已裁＝UTC_URL 指本实例库·零直连定案；HTTP 指生产 UTC）---
# [S0填] URL/USER/PWD 同类1（DBA 交回后）；UTC_SERVER_URL 已预填生产坐标
AGENTMP_UTC_URL=jdbc:mysql://__DBA_HOST__:__DBA_PORT__/__DBA_DBNAME__?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2B8
AGENTMP_UTC_USER=__DBA_APP_USER__
AGENTMP_UTC_PWD=MASKED
AGENTMP_UTC_SERVER_URL=http://47.96.163.197:8001

# --- 类3：UTC 身份（xhc2025 生产绑定·数字 ID 待 G5-prep 生产库取证，禁搬测试值）---
# [S0填] AGENT_ID/FLOW_ID/UNICOM_KUAIFU_AGENT_USER_ID 取证后注入；
#        TRANSFER_ACCOUNT_ID 无真值可绑维持 0（全工程零调用者，测试机已证不阻塞）
AGENTMP_UTC_AGENT_ID=0
AGENTMP_UTC_AGENT_NAME=agentmp-level1
AGENTMP_UTC_AGENT_FLOW_ID=0
AGENTMP_UTC_TRANSFER_ACCOUNT_ID=0
AGENTMP_UTC_TRANSFER_ACCOUNT_NAME=agentmp-cmp
AGENTMP_UNICOM_KUAIFU_AGENT_USER_ID=0
AGENTMP_UNICOM_KUAIFU_AGENT_USERNAME=agentmp-level1

# --- 类4：公众号（D1 修订＝暂缓，申请中；占位不阻塞启动）---
# [用户填] 凭据就位后填 APP_ID/APP_SECRET；OAUTH_REDIRECT 已预填生产域名
AGENTMP_WECHAT_MP_APP_ID=MASKED
AGENTMP_WECHAT_MP_APP_SECRET=MASKED
AGENTMP_WECHAT_MP_API_URL=https://api.weixin.qq.com/
AGENTMP_WECHAT_MP_MEDIA_URL=https://api.weixin.qq.com/cgi-bin/media/get?access_token={access_token}&media_id={media_id}
AGENTMP_WECHAT_MP_QRCODE_URL=https://mp.weixin.qq.com/cgi-bin/showqrcode?ticket={ticket}
AGENTMP_WECHAT_MP_OAUTH_URL="https://open.weixin.qq.com/connect/oauth2/authorize?appid={appid}&redirect_uri={redirect_uri}&response_type=code&scope={scope}&state={state}&connect_redirect=1#wechat_redirect"
AGENTMP_WECHAT_MP_OAUTH_REDIRECT=https://www.xhc123.work/api/web/wechat/mp/oauth/callback

# --- 类5：微信支付（APIv2 密钥用户已获取→[用户填]；其余凭据暂缓申请中）---
# [用户填] WXPAY_API_SECRET（已获取，自行填入）；APP_ID/MCH_ID 商户号申请就位后填
# [暂缓] p12 证书未获取；就位后 SSH 落机 etc/apiclient_cert.p12（compose 挂载届时放行）
AGENTMP_WXPAY_APP_ID=MASKED
AGENTMP_WXPAY_MCH_ID=MASKED
AGENTMP_WXPAY_API_SECRET=MASKED
AGENTMP_WXPAY_NOTIFY_URL=https://www.xhc123.work/api/web/pay/notify/wx
AGENTMP_WXPAY_CERT=./etc/apiclient_cert.p12
AGENTMP_WXPAY_API_URL=https://api.mch.weixin.qq.com

# --- 类6：Redis（compose 服务名；environment 覆盖同值）---
AGENTMP_REDIS_HOST=redis
AGENTMP_REDIS_PORT=6379
AGENTMP_REDIS_DB=0

# --- 类7：端口（仅绑 127.0.0.1 由 compose ports 控制）---
AGENTMP_SERVER_PORT=7013

# --- 补充A：快付 SDK（★源码定案：KuaifuSDK 全仓零方法调用＝装配残留，凭据运行期零消费）---
# [暂缓] APPID/APPSECRET/ADMIN_PWD/URL/DATA_POOL_ID 占位维持即可（方案§十五论证）；
#        AGENT_USER_ID/USERNAME 在类3（身份判据消费，须取证真值）
AGENTMP_UNICOM_KUAIFU_URL=http://127.0.0.1:10106
AGENTMP_UNICOM_KUAIFU_APPID=MASKED
AGENTMP_UNICOM_KUAIFU_APPSECRET=MASKED
AGENTMP_UNICOM_KUAIFU_TRANSFER_USER=agentmp-cmp
AGENTMP_UNICOM_KUAIFU_DATA_POOL_ID=0
AGENTMP_UNICOM_KUAIFU_ADMIN_USERNAME=agentmp-admin
AGENTMP_UNICOM_KUAIFU_ADMIN_PWD=MASKED
AGENTMP_UNICOM_KUAIFU_CAPTCHA_PATH=./var/tmp/captch.jpg

# --- 补充B：SMZ 物联卡平台（按需，预计不涉激活/实名）---
# [暂缓] 占位维持
AGENTMP_SMZ_APPID=MASKED
AGENTMP_SMZ_APPSECRET=MASKED
AGENTMP_SMZ_API_URL=https://smz.cuiot.cn

# --- 补充C：Captcha（登录链路零 captcha 消费·源码定案，不部署）---
# [暂缓] 占位维持
AGENTMP_CAPTCHA_URL=http://127.0.0.1/create.json
AGENTMP_CAPTCHA_USER=MASKED
AGENTMP_CAPTCHA_PWD=MASKED

# --- 补充D：卡费/头像（业务默认；头像 URL 预填生产域名）---
AGENTMP_CARD_FEE=9.9
AGENTMP_AVATAR_PATH=./var/tmp/
AGENTMP_AVATAR_URL_SUFFIX=https://www.xhc123.work/image/
AGENTMP_AVATAR_DEFAULT=https://www.xhc123.work/image/agent.jpg

# --- 补充E：充值结算系数（业务默认）---
AGENTMP_UTC_RECHARGE_DEDUCT_RATIO=0.04

# --- 补充F：层级判据（结构性）---
AGENTMP_TOP_LEVEL=1
AGENTMP_MAX_LEVEL=3

# --- 补充G：B3 预划拨两系数＋N4 token（空默认 fail-closed，禁漏注入/禁搬测试值）---
# [S0填] G5-prep 从生产 ryd_utc.t_agent_flow（xhc2025 主池行）逐字段取证＋token 受控注入
AGENTMP_UTC_AGENT_FLOW_COEFFICIENT=
AGENTMP_UTC_AGENT_FLOW_RECHARGE_MIN=
AGENTMP_UTC_OPENAPI_TOKEN=