# ============================================================================
# anchors/admin-web.env — G2 admin-web（Vite 形态静态 dist）
# 事实源：指纹台账.md §11 / §16 / §22.2 / §27 / §29；sop/SOP-04 §A；sop/SOP-06 §3
# ★ 2026-11-24 已换包：CURRENT 取本轮上线值（ee3eec79），上一版 5daccd9d 降为 ROLLBACK。
#   注意：SOP-04 A0 的表是 2026-11-18 之前的快照（d9ef7d95 / 4e9f978d），已过期两代；
#   「现役是什么」一律以本文件的 CURRENT_* 为准，不以 SOP 内联表为准（自纠 75）。
# ============================================================================
PROJECT=admin-web
GROUP=G2
SOP=sop/SOP-04-静态dist替换.md
MODE=static-dist
HOST_ALIAS=runyd-47-96-163-197
HOST_ROLE=UTC
STATUS=READY

# ---- 产物面 ----
SERVER=openresty/1.19.9.1
VHOST=servers/ryd-utc.conf
LISTEN=8000
SITE=utc.nlxq.net
DEPLOY_ROOT=/data/html/ryd-utc-admin/dist
PRIMARY_FILE=index.html
OWNER=nlxq:nlxq
DEPLOY_ROOT_MODE=755
# 生产 dist 实际文件数（递归）：65 新交付件 + 103 旧 assets − 22 同名 = 146（2026-11-24 切换后实测）
# 上一版为 106（交付件 65 ＋ 旧 assets 41）。KEEP_OLD_ASSETS=required → 这个数只会随批次单调增长，不是垃圾。
LIVE_FILE_CNT_BASELINE=146
DELIVERY_FILE_CNT=65

# 现役（2026-11-24 G2 换包后，commit dcf86e0；台账 §29；切换后五条判据全绿实测）
# ★ css 未变（同 sha 同字节）；新旧 js 字节数同为 1,386,384 —— 新旧只能靠 sha 区分，不能靠字节数。
CURRENT_FILES="index.html=ee3eec792c503d3f8fcdf0f7fae01d560aaf085a306807fa95304e593d089185:685 assets/index.0e0cb01e.js=40c1fece06ee3fb56a8446c95d2f32e82a54ac867ed5e8010eb355d5db3794e8:1386384 assets/index.293e09e1.css=293e09e129cfcdad9dcb6f1dd13e88871a0e0ff548b92abfba17efcfdd9734b2:411184"
# 回滚目标（＝本轮上线前现役；dist.pre-G2-20261124 与 dist.old-G2-20261124 两者逐字节一致）
# 回滚命令见 变更留痕/20261124-G2-admin-web换包/00-换包结论.md §十一；不重启任何服务
ROLLBACK_FILES="index.html=5daccd9d746c27c0d53eb6bb7256a2ef709ff6881704355a029325f592a03cd6:685 assets/index.05463381.js=a502e558b9efb12a16b4b2f0f4f0acca32df65c4d384733a710dbc1dc12f3c81:1386384 assets/index.293e09e1.css=293e09e129cfcdad9dcb6f1dd13e88871a0e0ff548b92abfba17efcfdd9734b2:411184"

# ---- 候选（2026-11-23 本地构建；★ 2026-11-24 已上线，本块转为上线记录，不再是"待授权"） ----
DEPLOYED_AT=2026-11-24
DEPLOYED_BATCH=G2-20261124
DEPLOYED_BACKUP=dist.pre-G2-20261124
DEPLOYED_OLD=dist.old-G2-20261124
DEPLOYED_DELIVERY=delivery-G2-20261124
DEPLOYED_JUDGE=5of5_index_sha,new_js200,old_js200,vhost_sha,nginx_pid
CANDIDATE_COMMIT=dcf86e0e5b3178465a832b5760739aa5029c9777
CANDIDATE_PARENT=48ccdcbf65bff742924e1b35dfc2c8c581d3e5ce
CANDIDATE_BUILD_ENV=node16.20.2|npm8.19.4|vite3.1.3|esbuild0.15.8|win32
CANDIDATE_FILES="index.html=ee3eec792c503d3f8fcdf0f7fae01d560aaf085a306807fa95304e593d089185:685 assets/index.0e0cb01e.js=40c1fece06ee3fb56a8446c95d2f32e82a54ac867ed5e8010eb355d5db3794e8:1386384 assets/index.293e09e1.css=293e09e129cfcdad9dcb6f1dd13e88871a0e0ff548b92abfba17efcfdd9734b2:411184"
# 与 CURRENT 的差距：ADD 40 / DEL 40 / CHG 1(index.html) / SAME 24，均为 Vite hash 级联
CANDIDATE_DIFF=add40_del40_chg1_same24
# 可复现性证明：父提交(48ccdcb)同环境重建 vs 生产现役 = 65/65 逐字节一致（零漂移）
REPRO_PROOF=base48ccdcb_eq_current_65of65
# 交付件准入：生产机 sha256sum -c 66/66 全 OK（CRLF 归一后），证据 delivery-G2-20261124/VERIFY.log
CANDIDATE_DELIVERY_VERIFIED=yes
# ★ 仍为 no：该候选从未在测试机跑过（用户 2026-11-23 裁定跳过），不得因已上生产而改写成 yes
CANDIDATE_TESTENV_VERIFIED=no

# ---- 禁动件 ----
VHOST_FILE=servers/ryd-utc.conf
VHOST_SHA=db1a0c12470d79d3845fb4a584cbad50dccf9c082cc4e10a48f28e90522c3133
VHOST_BYTES=1507
VHOST_PATH=/usr/local/openresty/nginx/conf/servers/ryd-utc.conf
IMMUTABLE_FILES=""
# 2026-11-23 实测 master pid 93674，启动于 2023-02-18 → 历次替换均未 reload
NGINX_MASTER_PID_BASELINE=93674
NGINX_MASTER_STARTED=2023-02-18T23:07:00

# ---- 服务面 ----
PORT=8000
RESTART=no
NGINX_RELOAD=forbidden

# ---- 备份 ----
BACKUP_DIR=/data/html/ryd-utc-admin
BACKUP_NAMING=dist.pre-G2-<date>
BACKUP_ROOT_FS_FORBIDDEN=no
# 旧 assets 并留＝强制（浏览器可能仍按旧 hash 请求，缓存期内不得 404）
KEEP_OLD_ASSETS=required

# ---- 判据 ----
PROBE=sha256_index,curl_index_sha,curl_old_js_200,curl_new_js_200
PROBE_EXPECT=四件 HTTP 200 且 index sha 等于新锚
HEALTH_URL=http://127.0.0.1:8000/
JUDGE_FORBIDDEN=systemctl is-active
JUDGE_REQUIRED=index_sha256_equal,new_js_200,old_js_200,vhost_sha_pre_and_post_equal
# 硬前置：G1 已通过且 12 探针 after 全绿（前端字典依赖后端 statusDesc 键）
HARD_PREREQ=G1 通过 + probe-utc-http 12/12

# ---- 已知缺口 ----
GAP=候选包未经测试机验证（用户 2026-11-23 裁定跳过；已于 2026-11-24 直接上生产并立即判据，此项不因上线而闭合）
GAP=交付件定源＝测试部署仓 origin/main web/dist/utc-admin 提取（禁 dev 构建产物上生产）；本次候选来自本地构建，属该口径的例外，已在台账 §27/§29 显式记录
GAP=CANDIDATE 内容差异仅由 UserRecharge/index.vue 的 min 1→0.1 引起，其余 39 个 chunk 换名均为 hash 级联（已由 REPRO_PROOF 反证）
GAP=三份构建产物的 SHA256SUMS.txt 均为 CRLF：Linux sha256sum -c 会因行尾 \r 全部报 FAILED（G2 实测 0/66）。部署侧靠 sed -i s/\r$// 归一绕开；根治须由构建侧（三件产物的生成脚本）产出 LF，属项目会话待办
GAP=scp -r 落地的目录权限为 0707（非 755，other 可写）：切换前必须 find <staging> -type d -exec chmod 755 {} +；文件侧 644 正常
GAP=历史备份目录名 dist.old-G2 已被 2026-10-26 批次占用：mv A B 在 B 已存在时会把 A 嵌进 B 内部形成 B/A，故本轮用 dist.old-G2-20261124；今后一律带日期，禁用无日期旧名
GAP=TEST_OPENID 不能作为 dev 产物判据：生产现役 G4/G6 包内亦各含 2 次（实测），SOP-04 §0.2 第 2 条的原理由失据，结论（定源口径）不变，真理由是"无法证明对应哪个 commit"
