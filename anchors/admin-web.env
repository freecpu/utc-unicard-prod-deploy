# ============================================================================
# anchors/admin-web.env — G2 admin-web（Vite 形态静态 dist）
# 事实源：指纹台账.md §11 / §16 / §22.2；sop/SOP-04 §A；sop/SOP-06 §3
# 注意：SOP-04 A0 写的是“换包前现役”（d9ef7d95），本文件 CURRENT 取 20261118 换包后新现役（5daccd9d）；
#       d9ef7d95 已降为 ROLLBACK（＝dist.pre-G2-20261118 的内容）。
# ============================================================================
PROJECT=admin-web
GROUP=G2
SOP=sop/SOP-04-静态dist替换.md
MODE=static-dist
HOST_ALIAS=runyd-47-96-163-197
HOST_ROLE=UTC
STATUS=READY

# ---- 产物面 ----
SERVER=openresty/1.19.9.1
VHOST=servers/ryd-utc.conf
LISTEN=8000
SITE=utc.nlxq.net
DEPLOY_ROOT=/data/html/ryd-utc-admin/dist
PRIMARY_FILE=index.html
OWNER=nlxq:nlxq

# 现役（2026-11-18 G2 换包后；台账 §22.2）
CURRENT_FILES="index.html=5daccd9d746c27c0d53eb6bb7256a2ef709ff6881704355a029325f592a03cd6:685 assets/index.05463381.js=a502e558b9efb12a16b4b2f0f4f0acca32df65c4d384733a710dbc1dc12f3c81:? assets/index.293e09e1.css=293e09e129cfcdad9dcb6f1dd13e88871a0e0ff548b92abfba17efcfdd9734b2:411184"
# 回滚目标（＝dist.pre-G2-20261118）
ROLLBACK_FILES="index.html=d9ef7d95dd29fb6611e1904c9cdd9b8217c3b684ccf050fa9037f2428170f6e7:685 assets/index.508ff2fc.js=e6a04f933c5925ab4be359741b7f93ed18dc00bcd858dfcb81505d7c609c24dd:1386131 assets/index.293e09e1.css=293e09e129cfcdad9dcb6f1dd13e88871a0e0ff548b92abfba17efcfdd9734b2:411184"

# ---- 禁动件 ----
VHOST_FILE=servers/ryd-utc.conf
VHOST_SHA=?
IMMUTABLE_FILES=""

# ---- 服务面 ----
PORT=8000
RESTART=no
NGINX_RELOAD=forbidden

# ---- 备份 ----
BACKUP_DIR=/data/html/ryd-utc-admin
BACKUP_NAMING=dist.pre-G2-<date>
BACKUP_ROOT_FS_FORBIDDEN=no
# 旧 assets 并留＝强制（浏览器可能仍按旧 hash 请求，缓存期内不得 404）
KEEP_OLD_ASSETS=required

# ---- 判据 ----
PROBE=sha256_index,curl_index_sha,curl_old_js_200,curl_new_js_200
PROBE_EXPECT=四件 HTTP 200 且 index sha 等于新锚
HEALTH_URL=http://127.0.0.1:8000/
JUDGE_FORBIDDEN=systemctl is-active
JUDGE_REQUIRED=index_sha256_equal,new_js_200,old_js_200,vhost_sash_pre_and_post_equal
# 硬前置：G1 已通过且 12 探针 after 全绿（前端字典依赖后端 statusDesc 键）
HARD_PREREQ=G1 通过 + probe-utc-http 12/12

# ---- 已知缺口 ----
GAP=assets/index.05463381.js 字节数未采
GAP=vhost conf sha 未采（G4 侧已有 6a8b8eb4，本项目缺）
GAP=交付件定源＝测试部署仓 origin/main web/dist/utc-admin 提取（65 文件 ZERO_DIFF），禁 dev 构建产物上生产
