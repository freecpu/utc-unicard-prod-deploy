# ============================================================================
# anchors/official-web.env — G4 official-web（umi 形态静态 dist）
# 事实源：指纹台账.md §12 / §21 / §22.4 / §30；sop/SOP-04 §B；sop/SOP-06 §3
# ★ 2026-11-24 已换包：CURRENT 取本轮上线值（80254a47 / d9ff64cf / a4028546），
#   上一版 31670ccf 组降为 ROLLBACK；再上一版 4e9f978d/892f3749 仍以旧文件名存活于 bin/。
#   注意：SOP-04 B0 的表是 2026-11-18 之前的快照，已过期两代；「现役是什么」一律以本
#   文件的 CURRENT_* 为准，不以 SOP 内联表为准（自纠 75）。
# ============================================================================
PROJECT=official-web
GROUP=G4
SOP=sop/SOP-04-静态dist替换.md
MODE=static-dist
HOST_ALIAS=runyd-47-111-157-5
HOST_ROLE=threeants
STATUS=READY

# ---- 产物面 ----
SERVER=nginx/1.7.4
VHOST=servers/threeantsonline.nlxq.net.conf
LISTEN=443
DEPLOY_ROOT=/usr/local/ryd-unicard/bin/dist
PRIMARY_FILE=index.html
OWNER=nlxq:nlxq
# /api/web/ → upstream 127.0.0.1:7003（G3）

# 现役（2026-11-24 本轮换包后；台账 §30）—— index 引用的 3 件 + static 2 件
CURRENT_FILES="index.html=80254a470b843bae49531c0baaf6b57100c1fd423bc5376c81d8d6318a7a0078:483 umi.d9ff64cf.js=e2ea3636e84b0907f15886ee51d88babfe3fc23d7ea2463b4c9d324c01916f79:1597357 umi.a4028546.css=cc0d20bf4ca4d97788004fec7a69c6e357c835f120879f1565b5ccffb04e9337:402076 static/help.c0d849ee.jpeg=397e6f7e40f965cbff94c6b375445d5d177753089238937c699e8907ff95ae29:42392 static/menu.429358a6.png=d12a11acd658c99bfe8c91fadb4a04146c6a07158a0acca244ecd75cdd653bdc:10140"
LIVE_FILE_CNT=8
# 并留的旧资源（KEEP_OLD_ASSETS，禁清理）：umi.dc9bce91.js / umi.8376da82.js / umi.b7afafd6.css
# 回滚目标（＝dist.pre-G4-20261124，即 2026-11-18 版现役）
ROLLBACK_FILES="index.html=31670ccf920afe8ae16f7ae8330fa099654ad319dba9e0716a1f4edf8270ce90:483 umi.dc9bce91.js=6c19b63505538274b74f0db31b7123265330d316ff1f79041c275ff5372fdb7b:1597309 umi.b7afafd6.css=01cc3e9371ca3bf9d9f7f3b342212edd74072a09784314c3b494f652520e2b01:402044"

# 本轮上线记录（2026-11-24；台账 §30）
DEPLOYED_AT=2026-11-24
DEPLOYED_BATCH=G4-20261124
DEPLOYED_SRC=unicard-official-nodejs dist-05724b5 / COMMIT=05724b51126ba4b99a6818a977f0df98789d0042 / PROFILE=prod
DEPLOYED_BACKUP=/data/log-archive/ryd-unicard/dist.pre-G4-20261124
DEPLOYED_OLD=/usr/local/ryd-unicard/bin/dist.old-G4-20261124
DEPLOYED_DELIVERY=/data/log-archive/ryd-unicard/delivery-G4-20261124
DEPLOYED_JUDGE=served_index_sha,new_js_css_200,old_assets_200,static_200,vhost_sha,nginx_master_pid,java_count,port7003

# ---- 禁动件 ----
VHOST_FILE=servers/threeantsonline.nlxq.net.conf
VHOST_SHA=6a8b8eb4f5f7876f340c413ff5ae483c61174b3dc655c844b26b3315f0bfeb89
IMMUTABLE_FILES=""

# ---- 服务面 ----
PORT=443
RESTART=no
NGINX_RELOAD=forbidden
# 替换前后必须核：nginx master PID 不变、同机 java 进程数不变、7003 仍 LISTEN
PEER_GUARDS=nginx_master_pid_unchanged,java_count_unchanged,port7003_listen

# ---- 备份 ----
BACKUP_DIR=/data/log-archive/ryd-unicard
BACKUP_NAMING=dist.pre-G4-<date>
BACKUP_ROOT_FS_FORBIDDEN=yes
ROOT_FS_MIN_FREE_MB=100
KEEP_OLD_ASSETS=required

# ---- 判据 ----
PROBE=sha256_index,curl_index_sha,curl_old_js_200,curl_new_js_200,curl_static_200
PROBE_EXPECT=五类全绿且 index sha 等于新锚
HEALTH_URL=https://127.0.0.1/
JUDGE_FORBIDDEN=systemctl is-active
JUDGE_REQUIRED=index_sha256_equal,new_js_200,old_js_200,vhost_sha_pre_and_post_equal,nginx_master_pid_unchanged
# ★ 硬前置：G3 已通过 且 probe-statusdesc.sh 实证 7003 返回非空 statusDesc 并经主管核验
HARD_PREREQ=G3 通过 + statusDesc 非空实证

# ---- 已知缺口 ----
# GAP=static 两件（帮助图/菜单图）锚未登记 → 2026-11-24 已实测并登记到 CURRENT_FILES（闭合）
GAP=交付件定源＝测试机在役 dist 原字节 tar 拉回（git 登记件 css 与在役脱节，禁直接用）
GAP=HTML 无 Cache-Control，X5 内核可能久缓存 index：生效验证以强刷/新会话为准
GAP=bin/ 下历史备份重名（裸 dist.old-G4 无日期）：mv 目标必须带日期，否则源目录被嵌进旧目录（自纠 82）
GAP=本机登录用户 runyd 与 dist 属主 nlxq 不同，部署动作全部须 sudo（sudo 免密可用，非 root 登录）
