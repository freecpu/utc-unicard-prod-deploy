# ============================================================================
# anchors/threeants.env — G3 threeants（unicard-official jar + systemd）
# 事实源：指纹台账.md §3 / §5 / §21 / §22.3；sop/SOP-03；sop/SOP-06 §3
# ★ 本服务风险高于 G1：同机 5 个 java 服务、根分区曾 94% 满、restart 以截断式
#   重定向清空 official.log（曾毁 502MB）、unit 承载两个 -D 修复值（换 jar 严禁动 unit）。
# ============================================================================
PROJECT=threeants
GROUP=G3
SOP=sop/SOP-03-threeants-生产换包.md
MODE=jar-systemd
HOST_ALIAS=runyd-47-111-157-5
HOST_ROLE=threeants
STATUS=READY

# ---- 产物面 ----
DEPLOY_ROOT=/usr/local/ryd-unicard/bin
PRIMARY_FILE=unicard-official-1.0.0.jar
LOG_FILE=/usr/local/ryd-unicard/var/official.log

# 现役（2026-11-18 G3 换包后；台账 §22.3）
CURRENT_FILES="unicard-official-1.0.0.jar=68b12477751ddfa6a74ba4b56cf032ab3420eaa84ffb6ea72dcb762da5063a6a:93136188"
# 回滚目标（10-28 基线）
ROLLBACK_FILES="unicard-official-1.0.0.jar=bd24267bcf629b528fe6bc4bedaa2cc57faccd031b9e2a820769e8c194732b05:93135977"

# ---- 禁动件 ----
IMMUTABLE_FILES=""
UNIT_FILE=/etc/systemd/system/ryd-unicard-official.service
UNIT_SHA=4a928353dcb3aa78dd209d8ee11786f1e525a6ab6b0a10503e030eefb20767cc
UNIT_BYTES=1385
# unit 含明文 OPENAPI_TOKEN：只允许 sudo sed 脱敏后输出，禁 cat / 禁 scp 回仓
UNIT_READ=sed_redacted_only
# 方案 A 的两个 -D 修复值必须在位，且位于 jar 路径之前
UNIT_REQUIRED_TOKENS=-Dutc.agent-flow-coefficient=50,-Dutc.agent-flow-recharge-min=0
UNIT_TOKEN_ORDER=before_jar

# ---- 服务面 ----
UNIT=ryd-unicard-official.service
PORT=7003
RESTART=yes
# 同机 5 个 java 服务：只许 restart 本单元，严禁 reload nginx / 动其他单元
SAME_HOST_FOREIGN_SERVICES=5
START_TIMEOUT_S=60

# ---- 备份 ----
BACKUP_DIR=/data/log-archive/ryd-unicard
BACKUP_NAMING=unicard-official-1.0.0.jar.pre-G3-<date>
BACKUP_MODE=600
# 备份/留档一律落 /data，禁落根分区（曾 94% 满）
BACKUP_ROOT_FS_FORBIDDEN=yes
ROOT_FS_MIN_FREE_MB=300
DATA_FS_MIN_FREE_MB=2048

# ---- 强制步 ----
# restart 前必须留档 official.log（ExecStart 用 > 截断）
PRE_RESTART_STEP=archive_official_log
# 回滚/换包后必须重跑注入通路验证
POST_STEP=scripts/apply-agentflow-fix.sh verify

# ---- 判据 ----
PROBE=scripts/probe-threeants-http.sh,scripts/probe-statusdesc.sh
PROBE_EXPECT=probe-threeants-http 全绿 + statusDesc 非空（G4 硬前置）
JUDGE_FORBIDDEN=systemctl is-active
JUDGE_REQUIRED=jar_sha256_equal,unit_sha_unchanged,two_d_flags_present,port_listen,started_line

# ---- 已知缺口 ----
GAP=G3 现役 68b12477 系 2026-11-18 换包后值，下次换包 precheck 须复核未漂移
GAP=根分区余量紧（曾 94%/1.3G），apply 前必须实测 df
GAP=unit 含明文凭据：任何新的读取路径都不得改变“只脱敏输出”口径
