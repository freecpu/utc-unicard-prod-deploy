# ============================================================================
# anchors/agent-mp.env — G5/G6 agent-mp（S5 jar ＋ S6 dist，首次部署）
# 事实源：指纹台账.md §18 / §20；sop/SOP-05（★占位·不可执行）
# ★ STATUS=BLOCKED：本机为空白规划机，无现役锚、无回滚对象、无部署史。
#   首次部署＝无参照系，验收用完整功能清单（判例：不得用相对基线口径）。
#   在 §3 部署方案经用户报核前，任何写命令一律禁；本文件仅供占位与缺口登记。
# ============================================================================
PROJECT=agent-mp
GROUP=G5-G6
SOP=sop/SOP-05-agent-mp-生产换包-占位.md
MODE=first-deploy
HOST_ALIAS=runyd-223-4-12-235
HOST_ROLE=第四台机（规划机）
STATUS=BLOCKED
BLOCKED_REASON=SOP-05 占位不可执行；首次部署方案未报核

# ---- 环境事实（R0/R1 只读侦察 2026-11-18）----
DOCKER_VERSION=29.1.3
JAVA_INSTALLED=no
NODE_INSTALLED=no
NGINX_INSTALLED=no
SSH_PORT=22
SSH_WHITELIST=none（出口 IP 不固定，用户明示暂不设）
SSL_DIR=/data/ssl
SSL_KEY_MODE=664（待收紧至 600，须授权）

# ---- 产物面（形态待部署方案定）----
DEPLOY_ROOT=?
PRIMARY_FILE=?

# 无锚：空白即 before 基线
CURRENT_FILES=""
ROLLBACK_FILES=""
IMMUTABLE_FILES=""

# ---- 服务面 ----
PORT=?
RESTART=?

# ---- 备份 ----
BACKUP_DIR=?
# 首次部署无旧包可回：回滚＝停服＋保留现场（须在方案中明写）
BACKUP_NAMING=none

# ---- 判据 ----
PROBE=?
PROBE_EXPECT=完整功能验收清单（方案阶段编制）
JUDGE_REQUIRED=port_listen,log_started_line,full_functional_acceptance

# ---- 已知缺口（全部为阻塞项）----
GAP=部署形态未定（Docker compose vs 裸 java/node ＋ nginx）
GAP=AGENTMP_* 注入点清单未编制（真值须走 SSH 管道，不落 git）
GAP=域名与证书接线未定（/data/ssl 三件指纹已登）
GAP=暴露面收紧未做：22 端口全网可达、SSL 私钥 664（无鉴权写端点上线前必须先锁裸端口）
GAP=回滚语义为“停服＋保留现场”，无旧包可回
GAP=部署窗口须与该机另一在线用户（X11 会话）协调
GAP=测试机 compose 形态不可外推（fail-closed）
