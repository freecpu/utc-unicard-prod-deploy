# ============================================================================
# anchors/agent-mp.env — agent-mp 生产锚（S6 前端 dist 静态替换；S5 后端另案）
# 事实源：指纹台账.md §24（G6 三锚）／§26（G7 五件）／§30（2026-11-24 再换包）；
#         变更留痕/20261119-G5G6首次部署方案/00-部署方案-v1.1-已裁.md §二十四/§二十五
# 规程：sop/SOP-07-agent-mp-静态dist替换.md
#
# ★ 2026-11-23 状态变更：STATUS 由 BLOCKED 转 READY
#   原「空白规划机、无现役锚、无回滚对象、无部署史」的判断已于 2026-11-20 被事实推翻：
#   G5 后端首次部署（2026-11-20）、G6 前端首次部署＋nginx 公网接线（2026-11-20）、
#   G7 B 端路由脱困＋登录门禁（2026-11-21）均已执行完毕并验收闭合。
#   本文件长期停留在 BLOCKED，是「权威文档过期」的实例之一（成因与纪律见 README.md §3 铁律 4）。
#   历史 BLOCKED 期的键（DOCKER_VERSION/JAVA_INSTALLED/NODE_INSTALLED/NGINX_INSTALLED/
#   SSL_KEY_MODE/SSH_WHITELIST）已随部署完成失去意义，一律删除；仅保留仍具约束力者。
# ============================================================================
PROJECT=agent-mp
GROUP=G5-G7
SOP=sop/SOP-07-agent-mp-静态dist替换.md
MODE=static-dist-swap
HOST_ALIAS=runyd-223-4-12-235
HOST_ROLE=生产第四台机（agent-mp 独占，nginx 1.24.0 Ubuntu）
STATUS=READY

# ---- 产物面（只管前端 dist；后端 Docker compose 不在本锚范围）----
DEPLOY_ROOT=/data/apps/agent-mp/dist
PRIMARY_FILE=index.html

# 现役五件（2026-11-24 本轮换包后；台账 §30）
CURRENT_FILES="index.html=f395af3a7781ff5b15bfc1daa71d0fe721c452cbf395a53217ca04e29ee16ca4:483 umi.956701c8.js=c281ad5dc5731b4d76694693ac57c3449ac5eaec2935d7d419149dfc1acd54c4:1764278 umi.ce19fd2a.css=b295b3dbc8e53a6cdb4a4f7312e9eb0cf6c95b1c72963a130019ac0ebee35af6:402076 static/help.c0d849ee.jpeg=397e6f7e40f965cbff94c6b375445d5d177753089238937c699e8907ff95ae29:42392 static/menu.429358a6.png=d12a11acd658c99bfe8c91fadb4a04146c6a07158a0acca244ecd75cdd653bdc:10140"
LIVE_FILE_CNT=9
# 并留的旧资源（KEEP_OLD_ASSETS，禁清理）：umi.8f0720bb.js／umi.478b4bfc.css（G7 版）
#                                          umi.65bb8d50.js／umi.730fc955.css（G6 首版）

# 回滚目标（＝dist.pre-G6-20261124，即 G7 版现役；static 两件三代逐字节未变，不需回滚）
ROLLBACK_FILES="index.html=bd337e78d9a3f783a396d791a49ac965ac05a7100ec01ec5e547b4e1c52a9f80:483 umi.8f0720bb.js=2fba8e738f2cd626b3fd9b2d1f428db2d6a8cb57421068b8ac87dce3bcc0586c:1764230 umi.478b4bfc.css=bfa59d934c915bcd879394630767036b9db3da91ba43be23cc6b3478c93b25d5:402044"

# 本轮上线记录（2026-11-24；台账 §30）
DEPLOYED_AT=2026-11-24
DEPLOYED_BATCH=G6-20261124
DEPLOYED_SRC=unicard-agent-mp-nodejs dist-7747178 / COMMIT=7747178e298bc9323ec7a65f781a6977cfb1e94b / PROFILE=prod
DEPLOYED_BACKUP=/data/apps/agent-mp/dist.pre-G6-20261124
DEPLOYED_DELIVERY=/data/apps/agent-mp/delivery-G6-20261124
DEPLOYED_STAGING=dist-staging-G6-20261124（用后已清）
# 实际使用的替换形态（SOP-07 §5 要求记录）：cd staging && find . -type f ! -name index.html
#   -exec cp -a --parents {} dist/ \; 然后 cp -a staging/index.html dist/index.html
DEPLOYED_SWAP_FORM=two_step_nonindex_then_index_with_cp_parents

# 禁动件（本规程全程不改；改 vhost 属另案授权）
# MP_verify 两枚完整 sha256 于 2026-11-24 机上四路探针（80/443 × 两侧）首次采齐（闭合原 GAP）
IMMUTABLE_FILES="/etc/nginx/sites-available/agentmp.conf=2e8fbc15e0ef0bf88c6ac7f4fcc44bdce3d4cbb9c9215df492cba6159dac40a8:2830 /data/apps/agent-mp/MP_verify_SoTNuLQw5OgweaCg.txt=d220661e923a13c2ef1c923168decf05305e2f4a1f815ffa8ee4a16510ce48ec:16 /data/apps/agent-mp/MP_verify_KDA52QyFQzUsiMnR.txt=7548e244f55cd8dfc3137884547446c68bb6277f044a62edc9a641395f62d154:16"

# ---- 服务面 ----
PORT=443
RESTART=none（纯静态替换：systemctl 零动作、nginx 零 reload；后端另案）
VHOST_FILE=/etc/nginx/sites-available/agentmp.conf
VHOST_SHA=2e8fbc15e0ef0bf88c6ac7f4fcc44bdce3d4cbb9c9215df492cba6159dac40a8
VHOST_BYTES=2830
NGINX_RELOAD=forbidden-for-static-swap（本机为独占机，改 vhost 时 reload 合法；改 dist 不需要）
KEEP_OLD_ASSETS=yes（旧 umi.65bb8d50.js／umi.730fc955.css 留在 dist 作回滚材料，禁清理）
SITE=https://www.xhc123.work
HEALTH_URL=https://www.xhc123.work/api/web/health
# 后端：Docker compose（agentmp-app ＋ agentmp-redis），仅绑回环 7013，对外经 nginx /api/ 反代

# ---- 备份 ----
BACKUP_DIR=/data/apps/agent-mp
BACKUP_NAMING=dist.pre-<批次>-<YYYYMMDD>
# 历史件（不改名）：dist-bak-g7-20261121

# ---- 判据 ----
PROBE=none
PROBE_EXPECT=ALL_OK
JUDGE_REQUIRED=machine_http_anchors,external_public_anchors,spa_fallback_content_level,mp_verify_dual_protocol,dotfile_reject,security_headers,nginx_untouched
JUDGE_FORBIDDEN=status_200_as_leak_proof,http_anchors_only_for_route_change,judge_before_cache_busting

# ---- 已知缺口（不阻断 dry-run；逐条阻断对应动作）----
GAP=专属探针未建（scripts/probe-agent-mp-web.sh 不存在；判据现由 SOP-07 §6 三路人工执行）
GAP=后端 jar／容器换包规程未抽成 SOP（G5 实测流水在变更留痕/20261119-G5G6首次部署方案/ §二十三）
# GAP=MP_verify 两枚完整 sha256 未采 → 2026-11-24 四路探针已采齐并写入 IMMUTABLE_FILES（闭合）
# GAP=dist 目录属主与 /data 磁盘余量未采 → 已采：dist 775 runyd:runyd、/data 40G 用 5.4G 剩 32G（闭合）
GAP=后端生产镜像 tag 未登记（本锚只覆盖前端；后端登记另案）
GAP=SOP-07 §5 原命令有两处缺陷（首次按规程执行时暴露）：①find -exec cp -a {} dist/ 会把 static/ 平铺成 dist/ 根，丢子目录层级；
    ②该命令会连带把 BUILD-INFO/SHA256SUMS.txt 落进生产静态根（可公网访问）。修正：先移出证件、再用 cd staging && find . -exec cp -a --parents {}
GAP=SOP-07 §6.1 ① 的 -H "Host: ..." 取值法在 PowerShell 转发时内层双引号被吃，会落到 default server；判据取值一律改用 --resolve
GAP=交付件仍以本地 Windows scp 上传，CRLF 归一依赖 sed -i s/\\r$//（单反斜杠经 ssh 会被远端 sh 吃掉而空转，自纠 82）
