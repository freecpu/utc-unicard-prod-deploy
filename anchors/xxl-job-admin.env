# ============================================================================
# anchors/xxl-job-admin.env — G8 xxl-job-admin（调度中心；jar + systemd fork 型）
# 事实源：变更留痕/20261123-G8-xxl-job-admin基线采集/01-原始输出-三轮只读采集-20261123.md（2026-11-23 实测）
# 规程：sop/SOP-08-xxl-job-admin-换包与回滚.md ｜ 回滚总纲：sop/SOP-06
#
# ★ STATUS=BLOCKED 的语义与 SOP-05 那次的教训不同，务必分开读：
#   SOP-05 的 BLOCKED ＝「尚未部署，无对象」；
#   本文件的 BLOCKED ＝「已部署且稳定运行 1373 天，但机上无任何回滚副本，换包无退路」。
#   解阻动作只有一个：SOP-08 §3（建备份 → 回填 ROLLBACK_FILES → 转 READY）。
#
# ★ 形状校验：bash deploy/_lib.sh lint xxl-job-admin
# ============================================================================
PROJECT=xxl-job-admin
GROUP=G8
SOP=sop/SOP-08-xxl-job-admin-换包与回滚.md
MODE=jar-systemd
HOST_ALIAS=runyd-47-96-163-197
HOST_ROLE=UTC（与 ryd-utc-admin 同机；调度中心为独立进程，不随 utc-admin jar 更新）
STATUS=BLOCKED
BLOCKED_REASON=无回滚材料：机上 jar_count=1 无任何历史副本；解阻＝SOP-08 §3 建备份后回填 ROLLBACK_FILES 并转 READY

# ---- 产物面 ----
DEPLOY_ROOT=/data/apps/xxl-job-admin
PRIMARY_FILE=xxl-job-admin.jar
LOG_DIR=/data/logs/xxl-job-admin
PIDFILE=/data/logs/xxl-job-admin/xxl-job-admin.pid

# 现役（2023-02-18 部署以来未换过包；2026-11-23 实测）
CURRENT_FILES="xxl-job-admin.jar=4c94e30ab99dd5719f21b204ea831326ebaa1d205088f50c858fd30df8543d71:46859824"
# ★ 空值是有意的：机上没有任何历史 jar，回滚目标不存在。不得填现役值冒充回滚锚。
ROLLBACK_FILES=""
# 应急退路（不解除 BLOCKED）：开发机离线副本与生产现役逐字节同锚，回滚需 scp 上传。见 SOP-08 §3.1
# ★ 该文件不在本仓版本管理内（d:/Freecpu/vscode/utc/xxl-job-admin/ 不是 git 仓），存在丢失风险
ROLLBACK_OFFLINE="d:/Freecpu/vscode/utc/xxl-job-admin/xxl-job-admin.jar=4c94e30ab99dd5719f21b204ea831326ebaa1d205088f50c858fd30df8543d71:46859824"

# ---- 禁动件（换包前后各采一次 sha，必须逐字不变＝"确实没碰"的唯一证据）----
# service.sh 与 utc-admin 的逐字节相同（台账 §16），属共用模板；两个 .env 则各自独立，禁跨服务复制
IMMUTABLE_FILES="service.sh=2ffe750f0211db65bf2001edd67caf0d6bf051d5bb10a08fac4b4716a82178b9:12888 .env=1b97338c1ca07788980a250bac2be7266ae1d46a3e129f9d99520f413484d1e8:200 custom.env=7cf950d38814b82141540b9f189f3906317cac1439b4a970a48f43054e7aaee8:359"
UNIT_FILE=/etc/systemd/system/xxl-job-admin.service

# ---- 服务面 ----
UNIT=xxl-job-admin.service
UNIT_TYPE=forking
# 运行身份 root:root（unit User=root + 目录 755）——scp 以 runyd 上传后必须 chown 回 root
PORT=8082
CONTEXT_PATH=/xxl-job-admin
# 实测绑定 *:8082（0.0.0.0），且 firewalld inactive、iptables 无 8082 规则 → 暴露面全赖云安全组
BIND_SCOPE=*:8082
JVM_OPTS=-Xms512m -Xmx512m
STARTED_BASELINE=Sat 2023-02-18 22:36:59 CST
MAINPID_BASELINE=89942
RESTART=yes
# 整点触发密集；重启期间到点的 cron 不补跑（SOP-08 §7 第 4 条）
RESTART_WINDOW_FORBID=HH:00-HH:05
# 配置注入方式：无 -D（cmdline 仅 74 B），配置在 .env / custom.env；SOP-02 的 -D 模式不可套用
CONFIG_MODE=env-files-no-Dflags

# ---- 备份 ----
BACKUP_DIR=/data/apps/xxl-job-admin
BACKUP_NAMING=xxl-job-admin.jar.bak-<YYYYMMDD>-pre-<版本或短sha>
BACKUP_ROOT_FS_FORBIDDEN=no

# ---- 判据 ----
PROBE=scripts/probe-xxljob-admin.sh
PROBE_EXPECT=probe-xxljob-admin.sh:jar_sha256/port_listen/toLogin_200
HEALTH_URL=http://127.0.0.1:8082/xxl-job-admin/toLogin
JUDGE_REQUIRED=jar_sha256_equal,MainPID_changed,port_listen,toLogin_200,started_marker_log,immutable_unchanged,owner_root_755
JUDGE_FORBIDDEN=systemctl_is_active_only,memory_current_as_capacity,jobhandler_log_file_as_proof,response_200_as_leak_proof

# ---- 与执行器的耦合（跨项目，SOP-08 §1.4）----
# 执行器内嵌在 ryd-utc-admin 进程内（executor ip=127.0.0.1:8083），无独立 utc-job 进程
EXECUTOR_EMBEDDED_IN=ryd-utc-admin
EXECUTOR_ADDR=127.0.0.1:8083
ADMIN_ADDR=http://127.0.0.1:8082/xxl-job-admin
# 跨大版本时两者必须同批换；未判定兼容性即视为不兼容（fail-closed）
VERSION_COUPLING=executor-core-version-unknown

# ---- 已知缺口（不阻断 dry-run，阻断 apply）----
GAP=无回滚副本（机上 jar_count=1）：STATUS=BLOCKED 的唯一原因，解阻见 SOP-08 §3
GAP=应急退路已登记：开发机离线副本与现役逐字节同锚（4c94e30a…），回滚需 scp 上传；不解除 BLOCKED
GAP=unit 文件 sha256 与字节未采（FragmentPath 已知为 /etc/systemd/system/xxl-job-admin.service）
GAP=执行器端 xxl-job-core 版本未采，跨大版本兼容性无法判定（须解包 utc-admin 内层 lib，只读）
GAP=.env 与 custom.env 的键名未采（按纪律未读正文；配置类变更前须单独授权读并脱敏归档）
GAP=jar 进程实际 RSS 未采（MemoryCurrent 实测 4096 字节，Type=forking 下该字段不可用）
GAP=8082 的云安全组放行范围机内无法判定（firewalld inactive、iptables 无 8082 规则）
GAP=库 xxl_job 位置未知（本机无 mysql 客户端、无 3306 监听）；执行日志在库内不在文件
GAP=调度中心是否管理着在线执行器未经人工确认（无登录态，不登录）
