# ============================================================================
# anchors/utc-admin.env — G1 utc-admin（jar + systemd fork 型）
# 事实源：指纹台账.md §19 / §22.1；sop/SOP-01；sop/SOP-06 §3
# ★ 机读锚。CURRENT_* = 生产现役（precheck 判“无漂移”）；ROLLBACK_* = 上一已验证版本。
#   换包成功后必须同一次提交内：旧 CURRENT → ROLLBACK，新值 → CURRENT。
#   形状校验：bash deploy/_lib.sh lint utc-admin
# ============================================================================
PROJECT=utc-admin
GROUP=G1
SOP=sop/SOP-01-utc-admin-生产换包.md
MODE=jar-systemd
HOST_ALIAS=runyd-47-96-163-197
HOST_ROLE=UTC
STATUS=READY

# ---- 产物面 ----
DEPLOY_ROOT=/data/apps/ryd-utc-admin
PRIMARY_FILE=ryd-utc-admin.jar
LOG_DIR=/data/logs/ryd-utc-admin
PIDFILE=/data/logs/ryd-utc-admin/ryd-utc-admin.pid

# 现役（2026-11-04 S3 换包后；台账 §19/§22.1）
CURRENT_FILES="ryd-utc-admin.jar=ba16cd657e6e645af24f14cc7a6fd34f802cdcbc441dd988cfc9ed055b904262:108561064"
# 回滚目标（S3 换包前）
ROLLBACK_FILES="ryd-utc-admin.jar=64f12e2fc0b93bc4041e2cf1ad09ada2b6211ece24bc6f0b202477fc81901dc1:108553312"

# ---- 禁动件（换包前后各采一次 sha，必须逐字不变＝“确实没碰”的唯一证据）----
IMMUTABLE_FILES="application-prod.yml=fdd79fc082f99f087f1c46c2156f73c891a472fbba33b66dd9ffd08f092cf4bc:629 .env=49d0eb8fa46423ff2592b35f891c9fdaa69ce3853f5efe0d38e6d7a572c4195b:338 custom.env=76bd9f6f635bc4f9e462c9b4b227c9550c34b95a7bd944055311201226333536:33 service.sh=2ffe750f0211db65bf2001edd67caf0d6bf051d5bb10a08fac4b4716a82178b9:12888"
UNIT_FILE=/etc/systemd/system/ryd-utc-admin.service
UNIT_SHA=d0efa566aa12421f1f2f654fd5d6d3372de668055e38f330f6cdd6dab84dbc77
UNIT_BYTES=?

# ---- 服务面 ----
UNIT=ryd-utc-admin.service
UNIT_TYPE=forking
SYSTEMD_VERSION=219
PORT=8001
CONTEXT_PATH=/manage
START_TIMEOUT_S=30
START_ELAPSED_BASELINE_S=14.6
RESTART=yes
# xxl-job 每小时 HH:00–HH:04 有 MQ 批处理峰值，重启须避开
RESTART_WINDOW_FORBID=HH:00-HH:04

# ---- 备份 ----
BACKUP_DIR=/data/apps/ryd-utc-admin
BACKUP_NAMING=ryd-utc-admin.jar.bak-<date>-pre-<shorthash>
BACKUP_ROOT_FS_FORBIDDEN=no

# ---- 判据 ----
# 只读探针：基线必须 12/12，残缺基线不得换包
PROBE=scripts/probe-utc-runtime.sh,scripts/probe-utc-http.sh,scripts/probe-utc-traffic.sh
PROBE_EXPECT=probe-utc-http.sh:12/12
HEALTH_URL=http://127.0.0.1:8001/manage/
JUDGE_FORBIDDEN=systemctl is-active,进程活着
JUDGE_REQUIRED=port_listen,log_started_line,jar_sha256_equal,MainPID_changed

# ---- 已知缺口（阶段 A 录入，待只读补采；不阻断 dry-run，阻断 apply）----
GAP=unit 字节数未采（unit sha 已有）
GAP=本锚写成于 2026-11-23，须在下次换包 precheck 时复核 ba16cd65 未漂移
GAP=应用目录存在 10 个历史 jar、5 种命名风格：回滚只认 sha256，不认文件名
